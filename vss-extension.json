{
  "manifestVersion": 1,
  "id": "asciidoc-viewer-azdevops",
  "publisher": "klab365",
  "version": "0.5.0",
  "name": "AsciiDoc Viewer",
  "description": "Preview AsciiDoc (.adoc/.asciidoc) files directly in Azure Repos, with local include:: resolution.",
  "public": false,
  "categories": ["Azure Repos"],
  "tags": ["asciidoc", "preview", "documentation", "repos"],
  "icons": {
    "default": "images/icon.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "links": {
    "getstarted": { "uri": "https://github.com/klab365/asciidoc-viewer-azdevops" },
    "support": { "uri": "https://github.com/klab365/asciidoc-viewer-azdevops/issues" },
    "repository": { "uri": "https://github.com/klab365/asciidoc-viewer-azdevops" }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/klab365/asciidoc-viewer-azdevops"
  },
  "branding": {
    "color": "rgb(190, 39, 3)",
    "theme": "light"
  },
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    }
  ],
  "scopes": ["vso.code"],
  "contributions": [
    {
      "id": "asciidoc-viewer-hub",
      "type": "ms.vss-web.hub",
      "description": "Browse a repository and preview an AsciiDoc file.",
      "targets": ["ms.vss-code-web.code-hub-group"],
      "properties": {
        "name": "AsciiDoc Viewer",
        "order": 100,
        "uri": "dist/hub.html"
      }
    }
  ]
}
