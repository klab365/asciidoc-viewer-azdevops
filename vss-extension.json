{
  "manifestVersion": 1,
  "id": "asciidoc-viewer-azdevops",
  "publisher": "klab365",
  "version": "0.2.3",
  "name": "AsciiDoc Viewer",
  "description": "Preview AsciiDoc (.adoc/.asciidoc) files directly in Azure Repos, with local include:: resolution.",
  "public": false,
  "categories": ["Azure Repos"],
  "tags": ["asciidoc", "preview", "documentation", "repos"],
  "icons": {
    "default": "images/icon.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "links": {
    "getstarted": { "uri": "https://github.com/klab365/asciidoc-viewer-azdevops" },
    "support": { "uri": "https://github.com/klab365/asciidoc-viewer-azdevops/issues" },
    "repository": { "uri": "https://github.com/klab365/asciidoc-viewer-azdevops" }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/klab365/asciidoc-viewer-azdevops"
  },
  "branding": {
    "color": "rgb(190, 39, 3)",
    "theme": "light"
  },
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "asciidoc-preview-action",
      "type": "ms.vss-web.action",
      "description": "Opens a preview dialog for .adoc/.asciidoc files in Azure Repos.",
      "targets": ["ms.vss-code-web.source-item-menu"],
      "properties": {
        "text": "AsciiDoc Preview",
        "title": "Preview this AsciiDoc file",
        "icon": "images/icon.png",
        "group": "actions",
        "uri": "dist/action.html"
      }
    },
    {
      "id": "asciidoc-preview-dialog",
      "type": "ms.vss-web.control",
      "description": "Dialog content that renders the AsciiDoc preview.",
      "targets": [],
      "properties": {
        "uri": "dist/renderer.html"
      }
    }
  ]
}
