{
  "name": "asciidoc-viewer-azdevops",
  "version": "1.2.0",
  "description": "Azure DevOps extension that renders AsciiDoc files as a Preview tab in Repos, resolving local includes.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "vite",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@asciidoctor/core": "^4.1.0",
    "azure-devops-extension-api": "^5.276.0",
    "azure-devops-extension-sdk": "^4.2.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
